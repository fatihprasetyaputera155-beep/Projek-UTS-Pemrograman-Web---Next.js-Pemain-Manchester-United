generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pemain {
  no_urut    Int    @id @default(autoincrement())
  nama       String
  posisi     String
  nomor_punggung Int
  negara     String
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}